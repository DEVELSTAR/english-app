# Server Configuration (cPanel or Local)
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (for cPanel phpMyAdmin MySQL)
# On cPanel: DB_HOST is usually 127.0.0.1
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=learn_english_db
DB_PORT=3306

# JWT Authentication Secret
JWT_SECRET=fluentedge_super_secret_jwt_key_2026_change_in_production

# Google Gemini API Key for AI English Tutor
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
